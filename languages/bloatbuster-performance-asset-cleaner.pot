#: includes/settings/tabs/class-tab-assets.php:39
msgid "Assets"
msgstr ""

#: includes/settings/tabs/class-tab-assets.php:50
msgid "Remove styles and scripts WordPress loads on the frontend that your site may not need."
msgstr ""

#: includes/settings/tabs/class-tab-assets.php:76
msgid "Disable Gutenberg block styles"
msgstr ""

#: includes/settings/tabs/class-tab-assets.php:77
msgid "Removes the block library CSS (wp-block-library) on the frontend. Only enable if your theme does not use blocks."
msgstr ""

#: includes/settings/tabs/class-tab-assets.php:82
msgid "Disable emoji scripts and styles"
msgstr ""

#: includes/settings/tabs/class-tab-assets.php:83
msgid "Disable all WordPress emoji scripts and styles."
msgstr ""

#: includes/settings/tabs/class-tab-assets.php:88
msgid "Disable Dashicons on the frontend when the toolbar is hidden"
msgstr ""

#: includes/settings/tabs/class-tab-assets.php:89
msgid "Removes the Dashicons stylesheet for logged-out visitors and users who do not see the admin toolbar. Users with the toolbar keep it, so the toolbar never breaks."
msgstr ""

#: includes/settings/tabs/class-tab-assets.php:94
msgid "Disable jQuery Migrate"
msgstr ""

#: includes/settings/tabs/class-tab-assets.php:95
msgid "Stop loading jQuery Migrate on the frontend. It stays active in the admin area."
msgstr ""

#: includes/settings/tabs/class-tab-background.php:39
msgid "Background Processes"
msgstr ""

#: includes/settings/tabs/class-tab-background.php:50
msgid "Control how often WordPress runs background requests like the Heartbeat API."
msgstr ""

#: includes/settings/tabs/class-tab-background.php:76
msgid "Disable Heartbeat API on the frontend"
msgstr ""

#: includes/settings/tabs/class-tab-background.php:77
msgid "Disable the WordPress Heartbeat API on the frontend but keep it active in the admin and post editor. Some frontend plugins (live chat, forms, membership) may rely on Heartbeat."
msgstr ""

#: includes/settings/tabs/class-tab-background.php:82
msgid "Control the Heartbeat API interval"
msgstr ""

#: includes/settings/tabs/class-tab-background.php:83
msgid "Set how often the Heartbeat API runs on the frontend, in the dashboard and in the post editor."
msgstr ""

#: includes/settings/tabs/class-tab-background.php:89
msgid "Frontend interval"
msgstr ""

#: includes/settings/tabs/class-tab-background.php:90
msgid "Seconds between Heartbeat requests on the frontend (15-120)."
msgstr ""

#: includes/settings/tabs/class-tab-background.php:100
msgid "Dashboard interval"
msgstr ""

#: includes/settings/tabs/class-tab-background.php:101
msgid "Seconds between Heartbeat requests in the admin area, except the post editor (15-120)."
msgstr ""

#: includes/settings/tabs/class-tab-background.php:111
msgid "Post editor interval"
msgstr ""

#: includes/settings/tabs/class-tab-background.php:112
msgid "Seconds between Heartbeat requests in the post editor, used for autosave and post locking (15-120)."
msgstr ""

#: includes/settings/tabs/class-tab-core.php:39
msgid "WordPress Core"
msgstr ""

#: includes/settings/tabs/class-tab-core.php:50
msgid "Turn off WordPress core features you do not use, like oEmbed, comments and pingbacks."
msgstr ""

#: includes/settings/tabs/class-tab-core.php:76
msgid "Disable oEmbed discovery and embed script"
msgstr ""

#: includes/settings/tabs/class-tab-core.php:77
msgid "Removes oEmbed discovery links, the wp-embed script and the oEmbed REST endpoint, so other sites can no longer embed your posts. Embeds from YouTube, Vimeo and other services in your content keep working."
msgstr ""

#: includes/settings/tabs/class-tab-core.php:82
msgid "Disable comments"
msgstr ""

#: includes/settings/tabs/class-tab-core.php:83
msgid "Disable comments, pingbacks and trackbacks across the entire site, including the admin area. Existing comments are hidden, not deleted."
msgstr ""

#: includes/settings/tabs/class-tab-core.php:88
msgid "Disable self-pingbacks"
msgstr ""

#: includes/settings/tabs/class-tab-core.php:89
msgid "Minor core cleanup: stops WordPress from sending pingbacks to its own posts."
msgstr ""

#: includes/settings/tabs/class-tab-core.php:94
msgid "Limit post revisions"
msgstr ""

#: includes/settings/tabs/class-tab-core.php:95
msgid "Keep only a set number of revisions per post. Overrides WP_POST_REVISIONS from wp-config.php while enabled."
msgstr ""

#: includes/settings/tabs/class-tab-core.php:101
msgid "Revisions to keep"
msgstr ""

#: includes/settings/tabs/class-tab-core.php:102
msgid "Number of revisions to keep per post. 0 disables revisions."
msgstr ""

#: includes/settings/tabs/class-tab-core.php:111
msgid "Remove unnecessary head tags"
msgstr ""

#: includes/settings/tabs/class-tab-core.php:112
msgid "Remove the WordPress version, RSD, Windows Live Writer, shortlink, REST API and adjacent post links from the page head and HTTP headers."
msgstr ""

#: includes/settings/tabs/class-tab-core.php:117
msgid "Disable XML-RPC"
msgstr ""

#: includes/settings/tabs/class-tab-core.php:118
msgid "Disable all XML-RPC methods, including pingbacks. Do not enable if you use Jetpack or the WordPress mobile app."
msgstr ""

#: includes/settings/tabs/class-tab-core.php:123
msgid "Disable user enumeration"
msgstr ""

#: includes/settings/tabs/class-tab-core.php:124
msgid "Hide usernames from the REST API users endpoint, ?author= URLs, the users sitemap and oEmbed data for visitors who can not edit posts. Makes brute force login attacks harder. Author archive pages keep working."
msgstr ""

